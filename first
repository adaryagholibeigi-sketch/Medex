  /* ==================== TEST ENGINE ==================== */
  var TEST_KEY = "medex.test.v2";
  var testState = null;
  var timerHandle = null;

  function saveTest(){ try { localStorage.setItem(TEST_KEY, JSON.stringify(testState)); } catch(e){} }
  function loadTest(){ try { var raw = localStorage.getItem(TEST_KEY); return raw ? JSON.parse(raw) : null; } catch(e){ return null; } }
  function clearTest(){ try { localStorage.removeItem(TEST_KEY); } catch(e){} }

  function renderTestSetup(){
    var container = document.getElementById("test-container");
    if (!container) return;
    var allQ = getAllQuestions();
    var createdCount = allQ.length;
    var combined = createdCount;

    var resumeHtml = "";
    var saved = loadTest();
    if (saved && !saved.finished){
      resumeHtml = ''
        + '<div class="resume-box">'
        +   '<div class="ico">▸</div>'
        +   '<div class="txt">یک آزمون نیمه‌تمام دارید ('+saved.answers.filter(function(a){return a!==null;}).length+' از '+saved.questions.length+' پاسخ داده شده)</div>'
        +   '<button type="button" id="btn-resume">ادامه</button>'
        + '</div>';
    }
    var resultHtml = "";
    if (saved && saved.finished){
      resultHtml = ''
        + '<div class="resume-box" style="background:linear-gradient(135deg,#E8F8F0,#D5F0E0);border-color:#A8DFC0">'
        +   '<div class="ico" style="background:#D5F5E3;color:#1e8449">✓</div>'
        +   '<div class="txt" style="color:#1e6a3a">آزمون قبلی تمام شده است. کارنامه آماده مشاهده است.</div>'
        +   '<button type="button" id="btn-show-result" style="background:#1e8449">مشاهده کارنامه</button>'
        + '</div>';
    }

    container.innerHTML = ''
      + resumeHtml
      + resultHtml
      + '<div class="setup-card">'
      +   '<div class="setup-group">'
      +     '<span class="setup-label">منبع سؤالات</span>'
      +     '<div class="setup-options" id="source-opts">'
      +       '<button class="setup-chip active" type="button" data-src="created">تألیفی</button>'
      +       '<button class="setup-chip" type="button" data-src="past" disabled style="opacity:.45;cursor:not-allowed">منتخب (به‌زودی)</button>'
      +       '<button class="setup-chip" type="button" data-src="both">هردو</button>'
      +     '</div>'
      +   '</div>'
      +   '<div class="setup-group">'
      +     '<span class="setup-label">تعداد سؤال</span>'
      +     '<div class="setup-options" id="count-opts">'
      +       '<button class="setup-chip" type="button" data-count="10">۱۰</button>'
      +       '<button class="setup-chip active" type="button" data-count="20">۲۰</button>'
      +       '<button class="setup-chip" type="button" data-count="50">۵۰</button>'
      +       '<button class="setup-chip" type="button" data-count="all">همه</button>'
      +     '</div>'
      +   '</div>'
      +   '<div class="setup-group">'
      +     '<span class="setup-label">زمان آزمون</span>'
      +     '<div class="setup-options" id="time-opts">'
      +       '<button class="setup-chip" type="button" data-time="0">بدون محدودیت</button>'
      +       '<button class="setup-chip" type="button" data-time="10">۱۰ دقیقه</button>'
      +       '<button class="setup-chip active" type="button" data-time="20">۲۰ دقیقه</button>'
      +       '<button class="setup-chip" type="button" data-time="30">۳۰ دقیقه</button>'
      +     '</div>'
      +   '</div>'
      +   '<div class="setup-info">'
      +     '<span>سؤالات موجود</span>'
      +     '<strong>'+combined+'</strong>'
      +   '</div>'
      +   '<button class="cta-btn" type="button" id="start-test">شروع آزمون</button>'
      + '</div>';

    function bindChips(groupId){
      var grp = document.getElementById(groupId);
      if (!grp) return;
      grp.addEventListener("click", function(ev){
        var btn = ev.target.closest(".setup-chip");
        if (!btn || btn.disabled) return;
        var chips = grp.querySelectorAll(".setup-chip");
        for (var i = 0; i < chips.length; i++) chips[i].classList.remove("active");
        btn.classList.add("active");
      });
    }
    bindChips("source-opts");
    bindChips("count-opts");
    bindChips("time-opts");

    var st = document.getElementById("start-test");
    if (st) st.addEventListener("click", function(){
      var src = document.querySelector("#source-opts .setup-chip.active").getAttribute("data-src");
      var cnt = document.querySelector("#count-opts .setup-chip.active").getAttribute("data-count");
      var tm = parseInt(document.querySelector("#time-opts .setup-chip.active").getAttribute("data-time"), 10);
      startTest(src, cnt, tm);
    });
    var br = document.getElementById("btn-resume");
    if (br) br.addEventListener("click", function(){
      testState = saved;
      if (!testState) return;
      renderTestRunning();
      if (testState.timeLimit > 0) startTimer();
    });
    var bsr = document.getElementById("btn-show-result");
    if (bsr) bsr.addEventListener("click", function(){
      testState = saved;
      if (!testState) return;
      renderTestResult();
    });
  }

  function startTest(src, cnt, timeMin){
    var pool = [];
    if (src === "created" || src === "both") pool = pool.concat(getAllQuestions());
    if (pool.length === 0){ alert("سؤالی برای این منبع موجود نیست."); return; }
    var count = cnt === "all" ? pool.length : Math.min(parseInt(cnt,10), pool.length);
    var selected = shuffle(pool).slice(0, count);

    testState = {
      source: src,
      count: selected.length,
      timeLimit: timeMin * 60,
      remaining: timeMin * 60,
      startedAt: Date.now(),
      questions: selected,
      answers: new Array(selected.length).fill(null),
      currentIdx: 0,
      finished: false
    };
    saveTest();
    renderTestRunning();
    startTimer();
  }

  function startTimer(){
    stopTimer();
    if (!testState || testState.timeLimit === 0) return;
    timerHandle = setInterval(function(){
      if (!testState || testState.finished){ stopTimer(); return; }
      testState.remaining--;
      if (testState.remaining <= 0){
        testState.remaining = 0;
        saveTest();
        stopTimer();
        finishTest(true);
        return;
      }
      saveTest();
      updateTimerDisplay();
    }, 1000);
  }
  function stopTimer(){ if (timerHandle){ clearInterval(timerHandle); timerHandle = null; } }
  function updateTimerDisplay(){
    var el = document.getElementById("q-timer");
    if (!el || !testState) return;
    if (testState.timeLimit === 0){ el.textContent = "∞"; el.classList.remove("warn"); return; }
    var r = testState.remaining;
    var m = Math.floor(r / 60), s = r % 60;
    el.textContent = (m<10?"0":"")+m+":"+(s<10?"0":"")+s;
    if (r <= 60) el.classList.add("warn"); else el.classList.remove("warn");
  }

  function renderTestRunning(){
    var container = document.getElementById("test-container");
    if (!container || !testState) return;
    var q = testState.questions[testState.currentIdx];
    var idx = testState.currentIdx;
    var total = testState.questions.length;
    var answered = testState.answers.filter(function(a){return a!==null;}).length;
    var pct = total > 0 ? Math.round((answered / total) * 100) : 0;
    var sel = testState.answers[idx];

    var optsHtml = "";
    for (var o = 0; o < q.opts.length; o++){
      var cls = "test-opt" + (sel === o ? " selected" : "");
      optsHtml += '<button class="'+cls+'" type="button" data-opt="'+o+'">'
                +   '<span class="opt-letter">'+esc(q.opts[o][0])+'</span>'
                +   '<span class="opt-text">'+esc(q.opts[o][1])+'</span>'
                + '</button>';
    }

    container.innerHTML = ''
      + '<div class="test-topbar">'
      +   '<div class="q-counter">سؤال <strong>'+(idx+1)+'</strong> از <strong>'+total+'</strong></div>'
      +   '<div class="q-timer" id="q-timer">--:--</div>'
      + '</div>'
      + '<div class="q-progress"><div class="q-progress-bar" style="width:'+pct+'%"></div></div>'
      + '<div class="test-q">'
      +   '<div class="test-q-text">'+levelTag(q.level)+esc(q.q)+'</div>'
      +   optsHtml
      + '</div>'
      + '<div class="test-nav">'
      +   (idx > 0 ? '<button class="cta-btn prev" type="button" id="btn-prev">قبلی</button>' : '')
      +   (idx < total-1
            ? '<button class="cta-btn next" type="button" id="btn-next">بعدی</button>'
            : '<button class="cta-btn next" type="button" id="btn-finish">پایان آزمون</button>')
      + '</div>'
      + '<div style="text-align:center;margin-top:12px">'
      +   '<button type="button" id="btn-abort" style="font-size:11.5px;color:var(--muted);text-decoration:underline;padding:6px 10px">لغو آزمون</button>'
      + '</div>';

    updateTimerDisplay();

    var optBtns = container.querySelectorAll(".test-opt");
    for (var i = 0; i < optBtns.length; i++){
      optBtns[i].addEventListener("click", function(){
        var o = parseInt(this.getAttribute("data-opt"), 10);
        testState.answers[testState.currentIdx] = o;
        saveTest();
        renderTestRunning();
      });
    }
    var bp = document.getElementById("btn-prev");
    if (bp) bp.addEventListener("click", function(){
      if (testState.currentIdx > 0){ testState.currentIdx--; saveTest(); renderTestRunning(); }
    });
    var bn = document.getElementById("btn-next");
    if (bn) bn.addEventListener("click", function(){
      if (testState.currentIdx < testState.questions.length - 1){ testState.currentIdx++; saveTest(); renderTestRunning(); }
    });
    var bf = document.getElementById("btn-finish");
    if (bf) bf.addEventListener("click", function(){
      var unanswered = testState.answers.filter(function(a){return a===null;}).length;
      var msg = unanswered > 0
        ? "هنوز "+unanswered+" سؤال بی‌پاسخ دارید. آیا مطمئنید؟"
        : "آزمون را تمام کنید؟";
      if (!confirm(msg)) return;
      finishTest(false);
    });
    var ba = document.getElementById("btn-abort");
    if (ba) ba.addEventListener("click", function(){
      if (!confirm("لغو آزمون و بازگشت به تنظیمات؟")) return;
      stopTimer();
      clearTest();
      testState = null;
      renderTestSetup();
    });
  }

  function finishTest(auto){
    stopTimer();
    testState.finished = true;
    testState.finishedAt = Date.now();
    testState.autoFinished = !!auto;
    saveTest();
    renderTestResult();
  }

  function renderTestResult(){
    var container = document.getElementById("test-container");
    if (!container || !testState) return;
    var total = testState.questions.length;
    var correct = 0, wrong = 0, unanswered = 0;
    for (var i = 0; i < total; i++){
      var a = testState.answers[i];
      if (a === null) unanswered++;
      else if (a === testState.questions[i].correct) correct++;
      else wrong++;
    }
    var pct = total > 0 ? Math.round((correct / total) * 100) : 0;
    var verdict, vclass;
    if (pct >= 80){ verdict = "عالی — آماده‌ای"; vclass = "good"; }
    else if (pct >= 60){ verdict = "خوب — نیاز به مرور"; vclass = "mid"; }
    else { verdict = "نیاز به مطالعه بیشتر"; vclass = "bad"; }

    var reviewHtml = "";
    var reviewCount = 0;
    for (var j = 0; j < total; j++){
      var q = testState.questions[j];
      var ans = testState.answers[j];
      var isCorrect = (ans === q.correct);
      var isUnanswered = (ans === null);
      if (isCorrect) continue;
      reviewCount++;
      var cls = isUnanswered ? "unanswered" : "wrong";
      var ansLine = "";
      if (isUnanswered){
        ansLine = '<div class="review-line wrong"><span class="lbl">پاسخ شما:</span> بی‌پاسخ</div>';
      } else {
        ansLine = '<div class="review-line wrong"><span class="lbl">پاسخ شما:</span> '+esc(q.opts[ans][0])+') '+esc(q.opts[ans][1])+'</div>';
      }
      var correctLine = '<div class="review-line correct"><span class="lbl">پاسخ صحیح:</span> '+esc(q.opts[q.correct][0])+') '+esc(q.opts[q.correct][1])+'</div>';
      reviewHtml += ''
        + '<div class="review-item '+cls+'">'
        +   '<div class="review-q"><span class="review-num">'+(j+1)+'</span>'+levelTag(q.level)+esc(q.q)+'</div>'
        +   ansLine
        +   correctLine
        +   '<div class="review-exp"><span class="lbl">توضیح</span><div class="txt">'+esc(q.exp)+'</div></div>'
        + '</div>';
    }
    if (reviewCount === 0){
      reviewHtml = '<div class="empty-box"><div class="empty-icon" aria-hidden="true">✓</div>همه سؤالات را درست پاسخ دادی.</div>';
    }

    container.innerHTML = ''
      + '<div class="result-hero">'
      +   '<small>کارنامه آزمون</small>'
      +   '<div class="result-percent">'+pct+'<span>٪</span></div>'
      +   '<p>'+correct+' از '+total+' سؤال درست</p>'
      +   '<div class="verdict '+vclass+'">'+verdict+'</div>'
      + '</div>'
      + '<div class="result-stats">'
      +   '<div class="result-stat good"><div class="num">'+correct+'</div><div class="lbl">صحیح</div></div>'
      +   '<div class="result-stat bad"><div class="num">'+wrong+'</div><div class="lbl">غلط</div></div>'
      +   '<div class="result-stat mute"><div class="num">'+unanswered+'</div><div class="lbl">بی‌پاسخ</div></div>'
      +   '<div class="result-stat"><div class="num">'+total+'</div><div class="lbl">کل</div></div>'
      + '</div>'
      + '<div class="result-actions">'
      +   '<button class="cta-btn" type="button" id="btn-retry">آزمون جدید</button>'
      +   '<button class="cta-btn secondary" type="button" id="btn-back-home">بازگشت به صفحه درس</button>'
      + '</div>'
      + (reviewCount > 0
          ? '<div style="margin-top:22px;margin-bottom:8px;font-size:13px;font-weight:700;color:var(--navy);padding-right:4px">مرور اشتباهات و توضیحات</div><div class="review-list">'+reviewHtml+'</div>'
          : '<div class="review-list">'+reviewHtml+'</div>');

    var brt = document.getElementById("btn-retry");
    if (brt) brt.addEventListener("click", function(){
      clearTest();
      testState = null;
      renderTestSetup();
    });
    var bbh = document.getElementById("btn-back-home");
    if (bbh) bbh.addEventListener("click", function(){
      showPage("courseHome");
    });
  }

  /* ==================== NAV ==================== */
  var COURSES = {
    infectious: { title: "تئوری عفونی", desc: "مرور و ارزیابی مباحث امتحان" },
    surgery:    { title: "کورس جراحی", desc: "آمادگی برای امتحان" }
  };
  var STORAGE_KEY = "medex.v1";
  function saveState(s){ try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch(e){} }
  function loadState(){ try { var r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null; } catch(e){ return null; } }

  var pages = document.querySelectorAll(".page");
  var app = document.querySelector(".app");
  function getPage(id){ if (!id) return null; var el = document.getElementById(id); return el && el.classList.contains("page") ? el : null; }
  var currentCourse = null;

  function showPage(id, opts){
    var target = getPage(id);
    if (!target){
      target = getPage("welcome");
      if (!target) return;
      id = "welcome";
    }
    for (var i = 0; i < pages.length; i++) pages[i].classList.remove("active");
    target.classList.add("active");
    try { window.scrollTo(0,0); } catch(e){}
    if (!opts || opts.persist !== false) saveState({ page: id, course: currentCourse });

    if (id === "test"){
      var saved = loadTest();
      if (testState && testState.finished){
        renderTestResult();
      } else if (testState && !testState.finished){
        renderTestRunning();
        if (testState.timeLimit > 0) startTimer();
      } else if (saved && saved.finished){
        testState = saved;
        renderTestResult();
      } else if (saved && !saved.finished){
        testState = saved;
        renderTestRunning();
        if (testState.timeLimit > 0) startTimer();
      } else {
        renderTestSetup();
      }
    }
  }

  function openCourse(id){
    var c = COURSES[id];
    if (!c) return;
    currentCourse = id;
    var setText = function(elId, txt){ var el = document.getElementById(elId); if (el) el.textContent = txt; };
    setText("selectedCourse", c.title);
    setText("courseDescription", c.desc);
    setText("heroTitle", c.title);
    setText("heroSub", "مسیر مطالعه");
    setText("summaryCourse", "مایندمپ جامع عفونی");
    setText("testCourse", c.title);
    showPage("courseHome");
  }

  app.addEventListener("click", function(ev){
    var t = ev.target;
    if (!t || !t.closest) return;
    var navBtn = t.closest("[data-nav]");
    if (navBtn){ showPage(navBtn.getAttribute("data-nav")); return; }
    var courseBtn = t.closest("[data-course]");
    if (courseBtn){ openCourse(courseBtn.getAttribute("data-course")); return; }
  });

  /* ==================== BOOT ==================== */
  renderBank();
  renderMindmap();
  renderTestSetup();

  var savedTest = loadTest();
  if (savedTest){ testState = savedTest; }

  window.MedEx = {
    showPage: showPage,
    openCourse: openCourse,
    version: "3.2.0",
    bankSize: getAllQuestions().length
  };

})();
</script>
</body>
</html>
