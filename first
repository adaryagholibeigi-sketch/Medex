      {t:"عوارض کلیدی", items:["فلوروکینولون: <em>پارگی تاندون آشیل</em>","آمینوگلیکوزید: نفروتوکسیسیتی + اوتوتوکسیسیتی","وانکومایسین سریع: <em>Red man syndrome</em>"]},
      {t:"اصول درمان تجربی", items:["سپسیس: محدودیت زمانی، اولویت ABC","شوک سپتیک منبع شکمی: کارباپنم","مرگ‌ومیر: در بارداری کمتر نیست"]},
      {t:"در حال حذف از خط اول", items:["کوتریموکسازول (فقط سیستیت)","سفوروکسیم، سفتازیدیم (مقاومت)"]}
    ]},
    {num:"۱۸", title:"سپسیس و FUO", branches:[
      {t:"تعاریف", items:["<strong>SIRS:</strong> ≥ ۲ معیار (تب، تاکی‌کاردی، تاکی‌پنه، لکوسیتوز/لکوپنی)","<strong>Sepsis:</strong> عفونت + اختلال عملکرد ارگان","<strong>Septic shock:</strong> هیپوتانسیون مقاوم + لاکتات بالا","<strong>FUO:</strong> تب > ۳ هفته، > ۳۸.۳°C، بدون تشخیص"]},
      {t:"qSOFA", items:["RR ≥ ۲۲ | تغییر هوشیاری | SBP < ۱۰۰ mmHg","نبض > ۹۰: <em>جزو qSOFA نیست</em>"]},
      {t:"FUO - اتیولوژی", items:["عفونت: TB، اندوکاردیت، آبسه","بدخیمی: لنفوم، لوسمی","روماتولوژیک: Still، SLE، JRA","متفرقه: DVT، دارو، تیروئید","<em>تومور مغزی: FUO نیست</em>"]},
      {t:"الگوهای تب", items:["Intermittent: بازگشت به نرمال","<strong>Remittent:</strong> نوسان، <em>بدون</em> بازگشت به نرمال","Continuous: ثابت | Relapsing: دوره‌ای"]},
      {t:"عفونت‌های بیمارستانی", items:["شایع‌ترین: عفونت ادراری (CAUTI)","پاتوژن شایع: <em>Pseudomonas aeruginosa</em>","پنومونی وابسته به ونتیلاتور"]},
      {t:"تظاهرات پوستی", items:["پتشی: منشأ عروقی | کهیر: Blanching","پورپورا: Non-blanching | واسکولیت: پورپورای قابل لمس"]},
      {t:"تله‌های طلایی", items:["هیپوترمی: پیش‌آگهی بدتر از تب بالا","اولویت در شوک سپتیک: <em>ABC</em>","سفتریاکسون در شوک سپتیک مطمئن نیست","قانون ۳ و ۳: تب > ۳ هفته، > ۳۸.۳°C، ۳ ویزیت سرپایی"]}
    ]}
  ];

  /* ==================== HELPERS ==================== */
  function esc(s){
    return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }
  function levelTag(level){
    var m = {easy:["آسان","easy"], medium:["متوسط","medium"], hard:["سخت","hard"]};
    var t = m[level] || m.medium;
    return '<span class="q-tag q-tag-'+t[1]+'">'+t[0]+'</span>';
  }
  function shuffle(arr){
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--){
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }
  function getAllQuestions(){
    var out = [];
    for (var s = 0; s < BANK.length; s++){
      var sec = BANK[s];
      for (var i = 0; i < sec.items.length; i++){
        var q = sec.items[i];
        out.push({
          n: q.n, level: q.level, q: q.q, opts: q.opts,
          correct: q.correct, exp: q.exp, section: sec.section
        });
      }
    }
    return out;
  }

  /* ==================== RENDER: BANK ==================== */
  function renderBank(){
    var root = document.getElementById("qbank-root");
    if (!root) return;
    var html = "";
    for (var s = 0; s < BANK.length; s++){
      var sec = BANK[s];
      html += '<div class="qbank-section">'+esc(sec.section)+'</div>';
      for (var i = 0; i < sec.items.length; i++){
        var q = sec.items[i];
        var optsHtml = "";
        for (var o = 0; o < q.opts.length; o++){
          // همه گزینه‌ها یکسان نمایش داده می‌شوند (بدون علامت صحیح)
          optsHtml += '<li><span class="opt-l">'+esc(q.opts[o][0])+')</span><span>'+esc(q.opts[o][1])+'</span></li>';
        }
        var correctLetter = q.opts[q.correct] ? q.opts[q.correct][0] : "";
        var cardId = "q-" + q.n;
        html += ''
          + '<div class="q-card" data-qid="'+cardId+'">'
          +   '<div class="q-card-head">'
          +     '<span class="q-card-num">'+q.n+'</span>'
          +     '<div class="q-card-text">'+levelTag(q.level)+esc(q.q)+'</div>'
          +   '</div>'
          +   '<ul class="q-card-options">'+optsHtml+'</ul>'
          +   '<button class="q-reveal" type="button" data-target="'+cardId+'-ans">'
          +     '<span class="reveal-label">نمایش پاسخ و توضیح</span>'
          +     '<span class="arrow-ico">▾</span>'
          +   '</button>'
          +   '<div class="q-answer-box" id="'+cardId+'-ans" style="display:none">'
          +     '<span class="lbl">پاسخ صحیح: '+esc(correctLetter)+'</span>'
          +     '<div class="txt">'+esc(q.exp)+'</div>'
          +   '</div>'
          + '</div>';
      }
    }
    root.innerHTML = html;

    var btns = root.querySelectorAll(".q-reveal");
    for (var b = 0; b < btns.length; b++){
      btns[b].addEventListener("click", function(){
        var targetId = this.getAttribute("data-target");
        var box = document.getElementById(targetId);
        if (!box) return;
        var isOpen = box.style.display !== "none";
        if (isOpen){
          box.style.display = "none";
          this.classList.remove("open");
          this.querySelector(".reveal-label").textContent = "نمایش پاسخ و توضیح";
        } else {
          box.style.display = "block";
          this.classList.add("open");
          this.querySelector(".reveal-label").textContent = "پنهان کردن پاسخ";
        }
      });
    }
  }

  /* ==================== RENDER: MINDMAP ==================== */
  function renderMindmap(){
    var root = document.getElementById("mindmap-root");
    if (!root) return;
    var html = "";
    for (var s = 0; s < MINDMAP.length; s++){
      var sec = MINDMAP[s];
