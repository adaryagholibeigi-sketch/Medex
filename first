<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0B3547">
<meta name="color-scheme" content="light">
<title>MedEx — تئوری عفونی</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{--navy:#0B3547;--blue:#164C63;--teal:#19878D;--teal-soft:#8AD9D4;--soft:#EAF5F6;--text:#17242C;--muted:#849198;--bg:#F5F8F9;--white:#fff;--line:#E3EBEE;--shadow:0 12px 34px rgba(11,53,71,.065);--shadow-hover:0 10px 26px rgba(11,53,71,.10);--success:#1e8449;--success-bg:#E8F8F0;--success-line:#27ae60;--danger:#c0392b;--danger-bg:#FDEDEC;--danger-line:#e74c3c;--warn:#b7950b;--warn-bg:#FEF9E7}
html,body{min-height:100%;background:#E9EEF0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,Arial,sans-serif;color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
button:focus-visible{outline:2px solid var(--teal);outline-offset:2px;border-radius:14px}
input,select{font:inherit;color:inherit}
.app{width:100%;max-width:480px;min-height:100vh;min-height:100dvh;margin:auto;background:var(--bg);overflow:hidden;position:relative}
.page{display:none;min-height:100vh;min-height:100dvh;padding:24px 21px 40px;position:relative}
.page.active{display:flex;flex-direction:column;animation:pageIn .28s cubic-bezier(.22,.61,.36,1)}
@keyframes pageIn{from{opacity:0;transform:translateX(10px)}to{opacity:1;transform:none}}

/* WELCOME */
.welcome{justify-content:center;align-items:center;text-align:center;padding:35px;overflow:hidden;background:radial-gradient(circle at 50% 38%,rgba(211,235,241,.85),transparent 46%),var(--bg)}
.welcome::before{content:"";position:absolute;width:260px;height:260px;border-radius:50%;background:rgba(105,190,199,.10);filter:blur(50px);top:32%;left:50%;transform:translate(-50%,-50%);animation:ambient 6s ease-in-out infinite}
.welcome::after{content:"";position:absolute;inset:0;opacity:.20;pointer-events:none;background-image:radial-gradient(#9bb7bf .7px,transparent .7px);background-size:22px 22px;-webkit-mask-image:linear-gradient(to bottom,transparent 12%,#000 50%,transparent 88%);mask-image:linear-gradient(to bottom,transparent 12%,#000 50%,transparent 88%)}
@keyframes ambient{50%{transform:translate(-50%,-50%) scale(1.08);opacity:.85}}
.logo-wrap{position:relative;z-index:1;width:min(62vw,224px);margin-bottom:26px;animation:logoIn .8s cubic-bezier(.16,1,.3,1) both,heartbeat 3.6s 1.2s ease-in-out infinite}
.logo-svg{display:block;width:100%;height:auto;overflow:visible}
.logo-svg .e-back{fill:none;stroke:var(--teal);stroke-width:4;stroke-linejoin:miter;stroke-linecap:square;opacity:.15}
.logo-svg .m-outer{fill:none;stroke:var(--navy);stroke-width:5;stroke-linejoin:miter;stroke-linecap:square}
.logo-svg .m-core{fill:none;stroke:var(--navy);stroke-width:1.6;stroke-linejoin:miter;stroke-linecap:square}
.logo-svg .pulse-line{fill:none;stroke:var(--teal);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:320;stroke-dashoffset:320;animation:draw 1.4s .5s ease forwards}
@keyframes draw{to{stroke-dashoffset:0}}
.logo-svg .m-text{fill:var(--navy);font-weight:800;letter-spacing:-1.2px}
.logo-svg .m-text-accent{fill:var(--teal)}
@keyframes logoIn{0%{opacity:0;transform:translateY(16px) scale(.84) rotate(-3deg)}60%{opacity:1;transform:translateY(-2px) scale(1.02) rotate(.5deg)}100%{transform:none}}
@keyframes heartbeat{0%,100%{transform:scale(1)}6%{transform:scale(1.015)}12%{transform:scale(1)}18%{transform:scale(1.02)}24%{transform:scale(1)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.start-btn{margin-top:34px;width:100%;max-width:305px;height:58px;border-radius:18px;background:linear-gradient(135deg,#1B5B73,#103E51);color:#fff;font-size:15.5px;font-weight:700;letter-spacing:.2px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 14px 30px rgba(16,62,81,.20),inset 0 1px 0 rgba(255,255,255,.14);transition:transform .16s ease,box-shadow .16s ease;animation:fadeUp .55s .4s both;z-index:1}
.start-btn:hover{box-shadow:0 16px 34px rgba(16,62,81,.25)}
.start-btn:active{transform:scale(.965);box-shadow:0 8px 18px rgba(16,62,81,.18)}

/* HEADER */
.header{display:flex;align-items:center;gap:13px;margin-bottom:24px;animation:fadeUp .3s ease-out}
.back{width:44px;height:44px;flex-shrink:0;border:1px solid var(--line);border-radius:14px;background:#fff;color:#65757D;font-size:24px;font-weight:400;line-height:1;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(20,40,50,.04);transition:transform .15s,background .15s;padding-bottom:3px}
.back:hover{background:#F0F5F7}
.back:active{transform:scale(.9);background:#E8EFF2}
.header-text h1{font-size:23px;font-weight:750;letter-spacing:-.5px;line-height:1.2}
.header-text p{margin-top:5px;color:var(--muted);font-size:12px}

/* CONTEXT */
.context{display:flex;align-items:center;justify-content:space-between;margin:-4px 2px 16px;padding:11px 13px;border:1px solid #E0EAED;border-radius:14px;background:rgba(255,255,255,.6);color:#74848B;font-size:10.5px}
.context strong{color:var(--blue);font-weight:700}
.context .dot{width:6px;height:6px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 4px rgba(25,135,141,.08);display:inline-block;margin-left:7px;vertical-align:middle}

/* CARDS */
.course-list,.main-options,.question-types{display:flex;flex-direction:column;gap:13px}
.course-card,.main-card,.question-card{border:1px solid var(--line);background:#fff;box-shadow:var(--shadow);opacity:0;transform:translateY(12px);animation:cardIn .42s cubic-bezier(.22,.61,.36,1) forwards;transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;width:100%}
.course-card:hover,.main-card:hover,.question-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-hover);border-color:#D8E4E8}
.course-card:active,.main-card:active,.question-card:active{transform:scale(.978);box-shadow:0 5px 15px rgba(18,48,62,.07)}
@keyframes cardIn{to{opacity:1;transform:none}}
.course-card{border-radius:22px;padding:19px;display:flex;align-items:center;justify-content:space-between;text-align:right;gap:12px}
.course-card:nth-child(2){animation-delay:.07s}
.course-info{display:flex;align-items:center;gap:15px;min-width:0;flex:1}
.course-icon,.main-icon{display:grid;place-items:center;flex-shrink:0;border-radius:17px;background:linear-gradient(145deg,#F0F8FA,#E4F0F3);color:var(--blue)}
.course-icon{width:52px;height:52px}
.course-icon svg,.main-icon svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.course-name{font-size:16px;font-weight:680;line-height:1.3}
.course-status{margin-top:5px;color:var(--muted);font-size:11px}
.arrow{color:#AAB5BA;font-size:22px;padding-bottom:4px;flex-shrink:0}
.main-card{min-height:112px;border-radius:23px;padding:21px;display:flex;align-items:center;gap:17px;text-align:right}
.main-card:nth-child(2){animation-delay:.07s}
.main-card:nth-child(3){animation-delay:.14s}
.main-icon{width:57px;height:57px;border-radius:18px}
.main-card h2{font-size:17px;font-weight:680;line-height:1.3}
.main-card p{margin-top:6px;color:var(--muted);font-size:11.5px;line-height:1.5}
.main-card > div:last-child{min-width:0;flex:1}
.question-card{position:relative;border-radius:22px;padding:24px;text-align:right}
.question-card:nth-child(2){animation-delay:.07s}
.question-card::after{content:"‹";position:absolute;left:21px;top:50%;transform:translateY(-50%);color:#AAB5BA;font-size:20px}
.question-card h2{font-size:17px;font-weight:680}
.question-card p{margin-top:7px;color:var(--muted);font-size:12px;padding-left:24px;line-height:1.6}

/* COURSE HERO */
.course-hero{position:relative;overflow:hidden;margin:-4px 0 17px;padding:18px 18px 14px;border-radius:23px;background:linear-gradient(145deg,#0B3547,#174D62);color:#fff;box-shadow:0 15px 32px rgba(11,53,71,.16)}
.course-hero::after{content:"";position:absolute;width:130px;height:130px;border:1px solid rgba(255,255,255,.08);border-radius:50%;left:-45px;bottom:-83px}
.course-hero small{color:var(--teal-soft);font-size:9px;letter-spacing:1.4px;font-weight:800}
.course-hero h2{margin-top:4px;font-size:21px;font-weight:700}
.course-hero p{margin-top:4px;font-size:11px;color:rgba(255,255,255,.7)}
.hero-line{display:block;width:100%;height:17px;margin-top:10px}
.hero-line path{fill:none;stroke:var(--teal-soft);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:180;stroke-dashoffset:180;animation:draw 1s .2s ease forwards}

/* EMPTY */
.empty-box{border:1px dashed #D4E0E4;border-radius:21px;padding:42px 22px;text-align:center;background:rgba(255,255,255,.6);color:#8C989E;font-size:13px;line-height:2;animation:fadeUp .35s ease-out}
.empty-icon{width:52px;height:52px;margin:0 auto 12px;border-radius:16px;background:var(--soft);display:grid;place-items:center;color:var(--teal);font-size:23px}
.footer-note{text-align:center;color:#A1ADB2;font-size:10.5px;margin-top:auto;padding-top:28px}

/* ============ QUESTION BANK ============ */
.qbank{display:flex;flex-direction:column;gap:12px;padding-bottom:20px}
.qbank-meta{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;margin-bottom:8px;border:1px solid #E0EAED;border-radius:14px;background:rgba(255,255,255,.6);color:#74848B;font-size:10.5px;animation:fadeUp .3s ease-out}
.qbank-meta strong{color:var(--blue);font-weight:700}
.qbank-section{margin-top:14px;border-radius:14px;background:linear-gradient(135deg,#164C63,#0B3547);color:#fff;padding:11px 16px;font-size:13px;font-weight:700;letter-spacing:-.2px;box-shadow:0 8px 20px rgba(11,53,71,.14);animation:cardIn .35s cubic-bezier(.22,.61,.36,1) both}
.qbank-section:first-child{margin-top:0}

.q-card{border:1px solid var(--line);background:#fff;border-radius:16px;padding:15px 16px;box-shadow:0 4px 14px rgba(11,53,71,.04);animation:cardIn .35s cubic-bezier(.22,.61,.36,1) both}
.q-card-head{display:flex;align-items:flex-start;gap:10px;margin-bottom:11px}
.q-card-num{flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;min-width:32px;height:24px;padding:0 8px;border-radius:8px;background:linear-gradient(145deg,#1D647E,#0B394C);color:#fff;font-size:11.5px;font-weight:800;letter-spacing:-.2px;box-shadow:0 3px 8px rgba(11,53,71,.18)}
.q-card-text{flex:1;min-width:0;font-size:13.5px;font-weight:700;color:var(--navy);line-height:1.7}
.q-card-options{list-style:none;display:flex;flex-direction:column;gap:6px;margin-bottom:11px}
.q-card-options li{padding:8px 12px;border-radius:9px;background:#F8FBFD;font-size:12.5px;line-height:1.6;color:#2c3e50;border-right:3px solid #D5E3EC;display:flex;gap:8px;align-items:flex-start}
.q-card-options li .opt-l{flex-shrink:0;font-weight:700;color:var(--blue);min-width:16px}

.q-reveal{width:100%;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 14px;border-radius:11px;background:linear-gradient(135deg,#F0F8FA,#E4F0F3);color:var(--blue);font-size:12.5px;font-weight:700;border:1px solid #D8E7EC;transition:all .15s}
.q-reveal:hover{background:linear-gradient(135deg,#E6F2F5,#DBEAEE)}
.q-reveal:active{transform:scale(.98)}
.q-reveal .arrow-ico{transition:transform .2s ease;font-size:11px}
.q-reveal.open .arrow-ico{transform:rotate(180deg)}

.q-answer-box{margin-top:11px;padding:12px 14px;border-radius:11px;background:#EAF6FF;border-right:4px solid var(--blue);animation:qBody .25s ease-out}
.q-answer-box .lbl{font-weight:800;color:var(--navy);font-size:12px;display:block;margin-bottom:6px}
.q-answer-box .txt{font-size:12.5px;line-height:1.8;color:#34495e}
@keyframes qBody{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

.q-tag{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10px;font-weight:700;margin-right:6px;vertical-align:middle}
.q-tag-easy{background:#D5F5E3;color:#1e8449}
.q-tag-medium{background:#FEF9E7;color:#b7950b}
.q-tag-hard{background:#FDEDEC;color:#c0392b}

/* ============ SUMMARY (Mindmap) ============ */
.mindmap{display:flex;flex-direction:column;gap:12px;padding-bottom:20px}
.mm-section{border:1px solid var(--line);background:#fff;border-radius:16px;box-shadow:var(--shadow);overflow:hidden;animation:cardIn .4s cubic-bezier(.22,.61,.36,1) both;transition:box-shadow .18s}
.mm-section:hover{box-shadow:var(--shadow-hover)}
.mm-head{list-style:none;cursor:pointer;padding:14px 16px;display:flex;align-items:center;gap:11px;background:linear-gradient(135deg,#F7FBFC,#EFF6F8);user-select:none;transition:background .15s}
.mm-head::-webkit-details-marker{display:none}
.mm-head:hover{background:linear-gradient(135deg,#F0F7F9,#E5EFF2)}
.mm-num{flex-shrink:0;width:30px;height:30px;border-radius:9px;background:linear-gradient(145deg,#1D647E,#0B394C);color:#fff;display:grid;place-items:center;font-size:12px;font-weight:800;box-shadow:0 4px 10px rgba(11,53,71,.18)}
.mm-title{flex:1;min-width:0;font-size:14.5px;font-weight:700;color:var(--navy);line-height:1.3}
.mm-chev{flex-shrink:0;color:var(--teal);font-size:15px;transition:transform .2s ease}
.mm-section[open] .mm-chev{transform:rotate(180deg)}
.mm-body{padding:14px 16px 18px;border-top:1px solid var(--line);background:#FDFEFE}
.mm-branch{margin-bottom:14px}
.mm-branch:last-child{margin-bottom:0}
.mm-branch-title{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:8px;padding-bottom:6px;border-bottom:1px dashed #D5E3EC}
.mm-branch-title::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 3px rgba(25,135,141,.12)}
.mm-list{list-style:none;display:flex;flex-direction:column;gap:6px;padding-right:14px;position:relative}
.mm-list::before{content:"";position:absolute;right:0;top:6px;bottom:6px;width:1px;background:linear-gradient(to bottom,transparent,#D5E3EC 20%,#D5E3EC 80%,transparent)}
.mm-list li{position:relative;font-size:12.5px;line-height:1.7;color:#34495e;padding-right:10px}
.mm-list li::before{content:"";position:absolute;right:-14px;top:11px;width:8px;height:1px;background:#D5E3EC}
.mm-list li strong{color:var(--navy);font-weight:700}
.mm-list li em{color:var(--teal);font-style:normal;font-weight:600}

/* ============ TEST SETUP ============ */
.setup-card{border:1px solid var(--line);background:#fff;border-radius:18px;padding:18px;box-shadow:var(--shadow);animation:cardIn .4s cubic-bezier(.22,.61,.36,1) both;margin-bottom:14px}
.setup-group{margin-bottom:18px}
.setup-group:last-child{margin-bottom:0}
.setup-label{display:block;font-size:12.5px;font-weight:700;color:var(--navy);margin-bottom:9px}
.setup-options{display:flex;flex-wrap:wrap;gap:8px}
.setup-chip{flex:1;min-width:0;padding:10px 8px;border:1.5px solid var(--line);border-radius:11px;background:#fff;color:#556;font-size:12.5px;font-weight:600;text-align:center;transition:all .15s;cursor:pointer;position:relative}
.setup-chip:hover{border-color:#B7CBD2;background:#FAFCFD}
.setup-chip:active{transform:scale(.97)}
.setup-chip.active{border-color:var(--teal);background:var(--soft);color:var(--navy);box-shadow:0 4px 12px rgba(25,135,141,.15)}
.setup-chip.active::after{content:"✓";position:absolute;top:-6px;left:-6px;width:18px;height:18px;border-radius:50%;background:var(--teal);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center;box-shadow:0 2px 6px rgba(25,135,141,.35)}
.setup-info{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:12px;background:linear-gradient(135deg,#F0F8FA,#E4F0F3);margin-bottom:14px;font-size:12px}
.setup-info span{color:var(--blue);font-weight:600}
.setup-info strong{color:var(--navy);font-weight:800;font-size:14px}

.resume-box{display:flex;align-items:center;gap:11px;padding:13px 14px;border-radius:13px;background:linear-gradient(135deg,#FEF9E7,#FDF3D6);border:1px solid #F0E0A0;margin-bottom:14px;animation:fadeUp .3s ease-out}
.resume-box .ico{flex-shrink:0;width:32px;height:32px;border-radius:10px;background:var(--warn-bg);color:var(--warn);display:grid;place-items:center;font-size:16px}
.resume-box .txt{flex:1;min-width:0;font-size:12px;color:#7a5a00;font-weight:600;line-height:1.5}
.resume-box button{flex-shrink:0;padding:8px 12px;border-radius:9px;background:var(--warn);color:#fff;font-size:11.5px;font-weight:700;transition:transform .15s}
.resume-box button:active{transform:scale(.95)}

.cta-btn{width:100%;height:56px;border-radius:15px;background:linear-gradient(135deg,#1B5B73,#103E51);color:#fff;font-size:15px;font-weight:700;letter-spacing:.2px;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 12px 26px rgba(16,62,81,.20),inset 0 1px 0 rgba(255,255,255,.14);transition:transform .16s ease,box-shadow .16s ease}
.cta-btn:hover{box-shadow:0 16px 34px rgba(16,62,81,.25)}
.cta-btn:active{transform:scale(.97);box-shadow:0 8px 18px rgba(16,62,81,.18)}
.cta-btn:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}
.cta-btn.secondary{background:#fff;color:var(--navy);border:1.5px solid var(--line);box-shadow:0 6px 16px rgba(20,40,50,.04)}
.cta-btn.secondary:hover{background:#F6FAFB;box-shadow:0 8px 20px rgba(20,40,50,.08)}

/* ============ TEST RUNNING ============ */
.test-topbar{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:13px;background:#fff;border:1px solid var(--line);box-shadow:0 6px 16px rgba(20,40,50,.04);margin-bottom:14px;animation:fadeUp .3s ease-out}
.test-topbar .q-counter{font-size:12px;color:var(--muted);font-weight:600}
.test-topbar .q-counter strong{color:var(--navy);font-weight:800}
.test-topbar .q-timer{display:flex;align-items:center;gap:5px;font-size:13px;font-weight:800;color:var(--teal);font-variant-numeric:tabular-nums;letter-spacing:.5px}
.test-topbar .q-timer.warn{color:var(--danger)}
.q-progress{height:5px;background:#E8EFF2;border-radius:99px;overflow:hidden;margin-bottom:16px}
.q-progress-bar{height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));border-radius:99px;transition:width .3s ease}
.test-q{border:1px solid var(--line);background:#fff;border-radius:18px;padding:18px;box-shadow:var(--shadow);animation:cardIn .35s cubic-bezier(.22,.61,.36,1) both;margin-bottom:14px}
.test-q-text{font-size:14.5px;font-weight:700;color:var(--navy);line-height:1.7;margin-bottom:14px}
.test-opt{display:flex;align-items:flex-start;gap:11px;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;background:#fff;margin-bottom:8px;cursor:pointer;transition:all .15s;text-align:right;width:100%;font-size:13px;line-height:1.6;color:#2c3e50}
.test-opt:hover{border-color:#B7CBD2;background:#FAFCFD}
.test-opt:active{transform:scale(.99)}
.test-opt .opt-letter{flex-shrink:0;width:26px;height:26px;border-radius:8px;background:var(--soft);color:var(--blue);display:grid;place-items:center;font-size:11.5px;font-weight:800;transition:all .15s}
.test-opt .opt-text{flex:1;min-width:0;padding-top:1px}
.test-opt.selected{border-color:var(--blue);background:#EAF6FF}
.test-opt.selected .opt-letter{background:var(--blue);color:#fff}
.test-nav{display:flex;gap:10px;margin-top:4px}
.test-nav .cta-btn{height:50px;font-size:14px}
.test-nav .cta-btn.prev{flex:0 0 40%;background:#fff;color:var(--navy);border:1.5px solid var(--line);box-shadow:none}
.test-nav .cta-btn.prev:hover{background:#F6FAFB}
.test-nav .cta-btn.next{flex:1}

/* ============ RESULT ============ */
.result-hero{text-align:center;padding:24px 18px;border-radius:22px;background:linear-gradient(145deg,#0B3547,#174D62);color:#fff;box-shadow:0 15px 32px rgba(11,53,71,.16);margin-bottom:16px;position:relative;overflow:hidden;animation:cardIn .5s cubic-bezier(.22,.61,.36,1) both}
.result-hero::after{content:"";position:absolute;width:150px;height:150px;border:1px solid rgba(255,255,255,.08);border-radius:50%;left:-55px;bottom:-90px}
.result-hero small{color:var(--teal-soft);font-size:10px;letter-spacing:1.6px;font-weight:800}
.result-percent{font-size:52px;font-weight:800;letter-spacing:-2px;margin:6px 0 4px;font-variant-numeric:tabular-nums}
.result-percent span{font-size:24px;font-weight:600;opacity:.7}
.result-hero p{font-size:12px;color:rgba(255,255,255,.75)}
.result-hero .verdict{display:inline-block;margin-top:12px;padding:5px 14px;border-radius:99px;font-size:11.5px;font-weight:800;letter-spacing:.3px;background:rgba(255,255,255,.13)}
.result-hero .verdict.good{background:rgba(39,174,96,.25);color:#A9F0C5}
.result-hero .verdict.mid{background:rgba(241,196,15,.25);color:#FCEBA6}
.result-hero .verdict.bad{background:rgba(231,76,60,.25);color:#F8C0B8}

.result-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.result-stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;text-align:center;box-shadow:0 6px 16px rgba(20,40,50,.04)}
.result-stat .num{font-size:24px;font-weight:800;letter-spacing:-.5px;font-variant-numeric:tabular-nums}
.result-stat .lbl{font-size:10.5px;color:var(--muted);margin-top:4px;font-weight:600;letter-spacing:.3px}
.result-stat.good .num{color:var(--success)}
.result-stat.bad .num{color:var(--danger)}
.result-stat.mute .num{color:var(--muted)}

.result-actions{display:flex;flex-direction:column;gap:10px;margin-top:6px}
.review-list{display:flex;flex-direction:column;gap:10px;padding-bottom:20px;margin-top:8px}
.review-item{border:1px solid var(--line);background:#fff;border-radius:14px;padding:14px;box-shadow:0 4px 14px rgba(11,53,71,.04);animation:cardIn .35s cubic-bezier(.22,.61,.36,1) both}
.review-item.wrong{border-color:#F5C6C0;background:#FFF8F7}
.review-item.unanswered{border-color:#F0E0A0;background:#FFFDF2}
.review-num{display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:22px;padding:0 7px;border-radius:8px;background:var(--soft);color:var(--blue);font-size:11px;font-weight:700;margin-left:8px;vertical-align:middle}
.review-item.wrong .review-num{background:var(--danger-bg);color:var(--danger)}
.review-item.unanswered .review-num{background:var(--warn-bg);color:var(--warn)}
.review-q{font-size:13.5px;font-weight:700;color:var(--navy);line-height:1.7;margin-bottom:10px}
.review-line{font-size:12.5px;line-height:1.75;padding:7px 11px;border-radius:8px;background:#F8FBFD;margin-bottom:6px;border-right:3px solid #D5E3EC;color:#2c3e50}
.review-line.correct{background:var(--success-bg);border-right-color:var(--success-line);color:var(--success);font-weight:600}
.review-line.wrong{background:var(--danger-bg);border-right-color:var(--danger-line);color:var(--danger);font-weight:600}
.review-line .lbl{font-weight:800;opacity:.85;margin-left:6px}
.review-exp{margin-top:8px;padding:11px 14px;border-radius:9px;background:#EAF6FF;border-right:4px solid var(--blue)}
.review-exp .lbl{font-size:11.5px;font-weight:800;color:var(--navy);display:block;margin-bottom:5px}
.review-exp .txt{font-size:12px;line-height:1.8;color:#34495e}

@media(max-width:360px){
  .page{padding-left:16px;padding-right:16px}
  .logo-wrap{width:min(58vw,180px)}
  .main-card{min-height:104px;padding:18px}
  .main-icon{width:52px;height:52px}
  .course-icon{width:48px;height:48px}
  .q-card-text{font-size:12.5px}
  .result-percent{font-size:44px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
